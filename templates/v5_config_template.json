{
  "_README": [
    "Template for v5_config.json - the master parameter table driving the PE Armington engine",
    "(orchestrator_v7_5.py). Fill every field for every chapter you model, then save this",
    "file as v5_config.json next to orchestrator_v7_5.py. Delete the _README and",
    "_field_guide keys or leave them; the code reads only the 'chapters' key.",
    "The 25 chapters below are the ones used in the published analysis (identity only,",
    "no values); add or remove chapters to fit your own country pair."
  ],
  "_field_guide": {
    "hs": "Two-digit HS chapter code as a string, e.g. \"23\"",
    "name": "Chapter display name",
    "eu_mfn": "EU MFN ad-valorem tariff on imports from the partner, as a decimal (5% -> 0.05)",
    "target_eu": "EU tariff at the end of the phase-out (usually 0.0)",
    "phase_eu": "EU-side phase-out length in years (integer)",
    "reduction_type": "\"Linear\" for a linear phase-out; \"None\" if the chapter is excluded from EU-side liberalization",
    "mer_mfn": "Partner-side (Mercosur) MFN tariff on your exports, as a decimal",
    "phase_mer": "Partner-side phase-out length in years; 0 = no reduction",
    "baseline_imp": "Baseline annual imports in USD (e.g. mean of the last three observed years)",
    "baseline_exp": "Baseline annual exports in USD",
    "cagr_imp": "Counterfactual import growth rate per year, as a decimal (winsorize thin-base chapters)",
    "cagr_exp": "Counterfactual export growth rate per year, as a decimal",
    "imp_elast": "Armington import elasticity (paper central value: -3.5)",
    "exp_elast": "Export elasticity (paper central value: -2.5)",
    "wedge": "Non-tariff cost wedge magnitude as a decimal (1.0 percentage point -> 0.010); enter the exporter-borne magnitude as a POSITIVE number - the code signs it by incidence at load time",
    "tier": "Free-text provenance note for the wedge calibration source",
    "citation": "Free-text citation for the chapter parameterization"
  },
